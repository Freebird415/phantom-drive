# ---- 编译产物 ----
.pio/
.pioenvs/
.piolibdeps/
Debug/
Release/
Objects/
Listings/
*.o
*.d
*.axf
*.elf
*.hex
*.bin
*.map
*.lst
*.htm
*.crf
*.dep
*.lnp

# ---- IDE / 编辑器 ----
# .vscode 只共享「团队公共配置」（按钮/任务），生成物（含本机绝对路径）不入库
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
firmware/.vscode/*
!firmware/.vscode/settings.json
!firmware/.vscode/tasks.json
!firmware/.vscode/extensions.json
.idea/
*.uvguix.*
*.uvoptx
*.scvd
JLinkLog.txt
RTE/

# ---- CAD / 3D 自动备份 ----
~$*
*.bak
*.tmp
*.swp
*.sldasm.bak
*.sldprt.bak

# ---- 系统 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- 智能体（AI）工具私有目录：不提交 ----
.reasonix/
.codebuddy/
.cursor/
.claude/
.continue/
.windsurf/
.trae/
.qoder/
.aider*
.codex/
node_modules/

# ---- Python（tools/ 脚本产物）----
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env

# ---- 实验日志（本地存档，不入库）----
# logs/ 不再整目录忽略：由 logs/.gitignore 只放行“共享_*.md”（2026-10-01）
logs/*
!logs/README.md
!logs/共享_*.md

# ---- 报销与成本台账（含发票/个人信息，仅本地保存，不入库）----
报销/

# ---- 参考资料：原文件入库；临时解析产物（pdf 转 txt/截图）本地再生，不入库 ----
参考资料/临时解析文件/
